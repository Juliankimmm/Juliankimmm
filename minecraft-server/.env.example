# Copy this file to .env and edit it. Compose reads .env automatically.

# --- Required ---------------------------------------------------------------
# Any long random string. Only used between the server and backup containers.
RCON_PASSWORD=change-me-to-something-long-and-random

# --- NAS file ownership -----------------------------------------------------
# The user/group IDs that should own the server files. Find yours over SSH
# with `id <your-nas-username>`. Common values:
#   Synology:       1026 / 100   (first admin-created user, "users" group)
#   TrueNAS SCALE:  568  / 568   (the "apps" user)
#   Unraid:         99   / 100   (nobody / users)
#   QNAP:           1000 / 100
MC_UID=1000
MC_GID=1000

# Where the world and backups are stored. Absolute paths on your NAS volume
# are safest, e.g. /volume1/docker/minecraft/data on Synology or
# /mnt/tank/apps/minecraft/data on TrueNAS.
DATA_DIR=./data
BACKUP_DIR=./backups

# --- Server -----------------------------------------------------------------
# PAPER (fast, supports plugins - recommended), VANILLA, FABRIC, FORGE, ...
SERVER_TYPE=PAPER
# LATEST, or pin an exact version like 1.21.10 so updates never surprise you.
MC_VERSION=LATEST
# Java heap size. The container uses roughly this plus ~1 GB, so leave room
# for the NAS itself. 2-3G for a few friends, 4-6G for 10+ or heavy plugins.
MEMORY=3G
# Your timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/New_York
# Host port players connect to. Change if 25565 is taken on the NAS.
MC_PORT=25565

MOTD=Welcome to the NAS server!
DIFFICULTY=normal
GAME_MODE=survival
MAX_PLAYERS=10
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6

# --- Who can join -----------------------------------------------------------
# Comma-separated Minecraft usernames. Ops get admin commands in-game.
OPS=YourMinecraftName
ENABLE_WHITELIST=true
WHITELIST=YourMinecraftName,FriendOne,FriendTwo

# --- Backups ----------------------------------------------------------------
BACKUP_INTERVAL=6h
PRUNE_BACKUPS_DAYS=14
